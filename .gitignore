# gitignore template for the IAR EWARM
# website: https://www.iar.com/

# Some tools will put the EWARM files
# under a subdirectory with the same name
# as the configuration.
# Example
# EWARM/Config1/Obj /List /Exe
# EWARM/Config2/Obj /List /Exe
Obj/
# List/
Exe/

# Autogenerated project files 
*.dep
*.ewt

# Autogenerated folder for debugger

#Autogenerated folder for settings
settings/

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Executables
#*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

.vscode/
demo_example/

#Telink
SDK/__boot__
#SDK/__controller__
SDK/.settings/

SDK/__controller__/app
SDK/__controller__/bluetooth
SDK/__controller__/boot
SDK/__controller__/common
SDK/__controller__/drivers
SDK/__controller__/output
SDK/__controller__/*.mk
SDK/__controller__/makefile
SDK/__controller__/*.lst
SDK/*.bin

!Moma_mesh_9517_250707_0xc0000_crc.bin

.metadata/
RemoteSystemsTempFiles/